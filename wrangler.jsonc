{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robinson",
  "main": "app/cloudflare/src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./app/cloudflare/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/games",
      "/games/*",
      "/demo",
      "/portraits/*",
      "/health"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
